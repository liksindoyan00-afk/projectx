# ── Database (PostgreSQL — e.g. Neon via Vercel Marketplace) ──────────────
# Pooled connection for the app, direct connection for migrations.
DATABASE_URL="postgresql://user:password@host:5432/bridgepath?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/bridgepath?sslmode=require"

# ── Site ─────────────────────────────────────────────────────────────────
# Public base URL, used for canonical / hreflang / sitemap.
SITE_URL="https://bridgepath.am"

# ── Admin panel ──────────────────────────────────────────────────────────
# Long random string (≥ 32 chars). Generate: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"
# First admin account, created by `npm run db:seed` (or `npm run admin:create`).
ADMIN_EMAIL="admin@bridgepath.am"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="BridgePath Admin"

# ── Enquiry notifications (all optional) ─────────────────────────────────
# Email via Resend (https://resend.com). Leave empty to disable email.
RESEND_API_KEY=""
EMAIL_FROM="BridgePath <hello@bridgepath.am>"
TEAM_INBOX="team@bridgepath.am"
# Send the family a copy of their enquiry in the page language ("true"/"false").
SEND_AUTOREPLY="true"

# Telegram alert to advisers. Leave empty to disable.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Salt for hashing IPs (rate limiting without storing raw IPs).
IP_HASH_SALT="change-me"
